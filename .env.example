# Postgres connection string. Neon in deployed environments (a different
# database per environment); a local Postgres works for dev too.
DATABASE_URL=
# Signs session cookies: a random string of at least 32 characters, different
# per environment. e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The app's public origin. Google redirects back to
# <BETTER_AUTH_URL>/api/auth/callback/google, which must be an authorised
# redirect URI of the Google OAuth client.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Allowlist: comma-separated email addresses allowed to sign in at all.
ALLOWLIST_EMAILS=
# Vercel Blob read/write token: where the Image Store copies Dish images.
# Connecting a Blob store to the Vercel project sets it there. Leave it empty
# locally to store images on disk under .data/images instead.
BLOB_READ_WRITE_TOKEN=
# Where images are stored on disk without a Blob token. Defaults to
# .data/images; the API tests set their own.
IMAGE_DIR=
# Vercel production only: the daily jobs (/api/cron/cleanup and
# /api/cron/email-digest, see vercel.json) refuse every request without it;
# Vercel Cron sends it. A random string of at least 16 characters, e.g.
# `openssl rand -base64 32`. Leave it empty locally.
CRON_SECRET=
# Push notifications: the VAPID key pair pushes are signed with (both
# base64url, from `npx web-push generate-vapid-keys`) and a contact the push
# services can reach about them (mailto: or https:). All three or none; empty,
# the settings offer no push notifications. The public key is read at build
# time too: the browser subscribes with it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The Email Digest: the Resend API key (re_…) the daily email is sent with,
# from the verified christried.me domain. Empty, the settings offer no
# digest and nothing is sent. Whether it is set is read at build time too:
# the settings show the switch only then.
RESEND_API_KEY=
# Tests only (never Vercel): where Resend's API is instead. The test runners
# set it to a stand-in; leave it empty.
RESEND_BASE_URL=
# Local dev only: '1' enables POST /api/auth/dev/sign-in, which signs in any
# Allowlisted email without Google. The server refuses to start with it on
# Vercel production or preview; never set it there. The test runners set it
# themselves.
AUTH_DEV_BYPASS=
# Tests only (never Vercel): superuser URL of the local Postgres
# that `pnpm test` and `pnpm test:e2e` use to create and drop a throwaway
# database per run, e.g. postgres://postgres:postgres@localhost:5432/postgres
# CI sets it in .github/workflows/ci.yml (a service container, no secret).
TEST_DATABASE_ADMIN_URL=
