    "pop": {
      "duration": "360–480ms",
      "easing": "cubic-bezier(.34,1.56,.64,1)",
      "spring": "spring k 380 · ζ 0.55",
      "use": "Badges, chips, dialogs, check marks, Neu"
    },
    "settle": {
      "duration": "480ms",
      "easing": "cubic-bezier(.3,1.3,.5,1)",
      "spring": "spring k 300 · ζ 0.7",
      "use": "Swipe snap, drop, cards making room"
    },
    "sheet": {
      "duration": "440ms",
      "easing": "cubic-bezier(.3,1.15,.5,1)",
      "spring": "spring k 260 · ζ 0.8",
      "use": "Bottom sheets, side panel, keyboard"
