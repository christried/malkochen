  "breakpoints": {
    "phone": {
      "max": 767,
      "layout": "One Column at a time, swipe between Columns, pebble tabs, detail full-screen route, sheets from bottom"
    },
    "tablet": {
      "min": 768,
      "max": 1199,
      "layout": "Kanban lanes (340px, scroll-snap), detail as 440px side panel, sheets become centred dialogs (max 620px)"
    },
    "desktop": {
      "min": 1200,
      "layout": "Kanban lanes (330px) + add-Column lane, detail 480px side panel, dialogs, hover motion, keyboard shortcuts"
    },
    "note": "Switch at 768px. Below 768 keep touch gestures; at 768+ with pointer:coarse keep long-press drag; with pointer:fine enable hover and direct mouse drag."
  },
