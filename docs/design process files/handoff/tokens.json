  "motion": {
    "tap": {
      "ms": 120,
      "ease": "cubic-bezier(.2,0,0,1)",
      "use": "Press feedback on every button and card"
    },
    "fade": {
      "ms": 240,
      "ease": "ease",
      "use": "Scrims, captions, reduced-motion fallback"
    },
    "pop": {
      "ms": 460,
      "ease": "cubic-bezier(.34,1.56,.64,1)",
      "use": "Badges, chips, dialogs, check marks, Neu"
    },
    "settle": {
      "ms": 480,
      "ease": "cubic-bezier(.3,1.3,.5,1)",
      "use": "Swipe snap, drop, cards making room"
    },
    "sheet": {
      "ms": 440,
      "ease": "cubic-bezier(.3,1.15,.5,1)",
      "use": "Bottom sheets, side panel, keyboard"
    },
    "swoosh": {
      "ms": 600,
      "ease": "cubic-bezier(.45,0,.2,1)",
      "use": "Shared-element morph, fly-to-tab, theme reveal"
    },
    "lift": {
      "ms": 180,
      "ease": "cubic-bezier(.3,1.3,.5,1)",
      "use": "Long-press / drag pick-up"
    },
    "stagger": {
      "ms": 60,
      "ease": null,
      "use": "Per item, max 8 items"
    },
    "type": {
      "ms": 30,
      "ease": "linear",
      "use": "Per character"
    },
    "celebrate": {
      "ms": 2400,
      "ease": null,
      "use": "Gekocht, 10×, Board created: one-shot only"
    },
    "idle": {
      "ms": 3000,
      "ease": "ease-in-out",
      "use": "Illustration loops, Topfbert, add pebble breathe"
    }
  },
